# ---- SMTP (Gmail) ----
# Generate at https://myaccount.google.com/apppasswords (2FA required)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=qilinfish@gmail.com
MAIL_PASSWORD=replace-with-google-app-password
MAIL_FROM=qilinfish@gmail.com

# Where contact-form notifications are delivered.
# Use a domain address so Cloudflare Email Routing can forward it.
MAIL_TO=qilinfish@qilinfish.com

# ---- Cloudflare Tunnel ----
# Get token from: Cloudflare Zero Trust → Networks → Tunnels → Create
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
